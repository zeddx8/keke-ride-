APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
RIDE_BASE_FARE=5.00
RIDE_FARE_PER_KM=3.00
RIDE_LOCATION_FRESHNESS_MINUTES=5
# Public OSM/OSRM demo services are for development; configure a production provider before launch.
PLACE_SEARCH_URL=https://nominatim.openstreetmap.org/search
PLACE_SEARCH_USER_AGENT="KekeRide/1.0 (contact: support@example.com)"
PLACE_SEARCH_COUNTRY_CODES=gh
PLACE_SEARCH_TIMEOUT_SECONDS=8
PLACE_SEARCH_CONNECT_TIMEOUT_SECONDS=3
PLACE_SEARCH_CACHE_TTL_SECONDS=600
# Keep at least 1 second for the public Nominatim service; check your provider's usage policy.
PLACE_SEARCH_PROVIDER_INTERVAL_SECONDS=1
ROUTING_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=8
ROUTING_CONNECT_TIMEOUT_SECONDS=3
ROUTING_CACHE_TTL_SECONDS=300

HUBTEL_SMS_URL=https://smsc.hubtel.com/v1/messages/send
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=KekeRide
HUBTEL_SMS_TIMEOUT_SECONDS=10
HUBTEL_SMS_CONNECT_TIMEOUT_SECONDS=5

# Firebase Cloud Messaging legacy server key
# Use a secret stored in the backend environment; never expose this value to mobile code.
FIREBASE_SERVER_KEY=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
